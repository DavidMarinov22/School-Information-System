@page "/Register"
@model RegisterModel
<div class="align">
    <div class="grid align__item">

        <div class="register">
            
            <img src="https://spge-bg.com/wp-content/uploads/2017/05/LogoSPGEwebTr.png" alt="СПГЕ &quot;Джон Атанасов&quot;" width="50" height="50">
            <span class="headerText">SOFIA VOCATIONAL HIGH SCHOOL OF ELECTRONICS "JOHN ATANASSOV"</span>
            <h2>New user</h2>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>


                <div class="form form-field">
                    <input asp-for="Input.Email" class="username" placeholder="Email" style="margin-bottom:5px" autocomplete="username" aria-required="true" />
                    <br />
                    <span asp-validation-for="Input.Email" class="text-danger" ></span>
                </div>

                <div class="form form-field">
                    <input asp-for="Input.Password" class="pass" placeholder="Password" style="margin-bottom:5px" autocomplete="new-password" aria-required="true" />
                    <br />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="form form-field">
                    <input asp-for="Input.ConfirmPassword" class="pass" style="margin-bottom:5px" placeholder="Confirm password" autocomplete="new-password" aria-required="true" />
                    <br />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="form__field">
                    @*<input type="submit" value="Sign Up">*@

                    <button id="registerSubmit" type="submit" class="button button2">REGISTER</button>
                </div>

            </form>

        </div>

    </div>
</div>
<div class="row">
    <div class="col-md-12" style="text-align:center;padding:inherit;padding-left:35%;padding-right:35%">
    </div>
</div>
<style>
    body {
  margin: 0;
  min-height: 100%;
        background-color: #354152;
        color: #7e8ba3;
        font: 300 #{1rem}/#{1.5} Helvetica Neue, sans-serif;
    }

    img{
        display: block;
        float: left;
        margin-left: 1rem;
    }
    .headerText{
        font-size: 80%;
        opacity: 70%;
          color: #7e8ba3;
          font-family: 'Times New Roman';
    }

    .grid {
        margin: 0 auto;
        max-width: 25rem;
        width: 100%;
    }

    .align {
        align-items: center;
        display: flex;
        flex-direction: row;
    }
    h2 {
  font-size: 2.75rem;
  font-weight: 100;
  margin: 1rem 0 2rem;
  text-transform: uppercase;
  float: none;
}

    .form-field {
        margin-bottom: 1rem;
    }

    .register {
        box-shadow: 0 0 250px #000;
        text-align: center;
        padding-bottom: 3rem;
        padding-top: 1rem;
    }

    .button {
        background-color: #4CAF50; /* Green */
        border: none;
        border-radius: 8px;
        color: white;
        padding: 15px 32px;
        text-align: center;
        text-decoration: none;
        display: inline-block;
        font-size: 14px;
        width: 70%;
        margin-top: 15px !important;
        margin: 4px 2px;
        cursor: pointer;
        -webkit-transition-duration: 0.4s; /* Safari */
        transition-duration: 0.4s;
    }

    .button2:hover {
        box-shadow: 0 12px 16px 0 rgba(0,0,0,0.24),0 17px 50px 0 rgba(0,0,0,0.19);
    }

    .username {
        width: 80%;
        color: rgb(38, 50, 56);
        font-weight: 700;
        font-size: 14px;
        letter-spacing: 1px;
        background: #e9ecef;
        padding: 10px 20px;
        border: none;
        border-radius: 1.5rem;
        outline: none;
        box-sizing: border-box;
        border: 2px solid rgba(0, 0, 0, 0.02);
        margin-bottom: 50px;
        text-align: center;
        margin-bottom: 27px;
        font-family: 'Ubuntu', sans-serif;
    }
    .pass {
        width: 80%;
        color: rgb(38, 50, 56);
        font-weight: 700;
        font-size: 14px;
        letter-spacing: 1px;
        background: #e9ecef;
        padding: 10px 20px;
        border: none;
        border-radius: 20px;
        outline: none;
        box-sizing: border-box;
        border: 2px solid rgba(0, 0, 0, 0.02);
        margin-bottom: 50px;
        text-align: center;
        margin-bottom: 27px;
        font-family: 'Ubuntu', sans-serif;
    }
        .username:focus, .pass:focus {
            border: 2px solid rgba(0, 0, 0, 0.18) !important;
        }
</style>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
