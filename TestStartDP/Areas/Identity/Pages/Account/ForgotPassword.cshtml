@page "/ForgotPassword"
@model ForgotPasswordModel

<div class="align">
    <div class="grid align__item">

        <div class="register">
            <img src="https://spge-bg.com/wp-content/uploads/2017/05/LogoSPGEwebTr.png" alt="СПГЕ &quot;Джон Атанасов&quot;" width="100" height="100">
            
            <h2>Вход</h2>

             <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form form-field">
                <input asp-for="Input.Email" class="username" placeholder="Email" autocomplete="username" aria-required="true" />
                <br />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="button button2">Смени паролата</button>
        </form>
        </div>
    </div>
</div>

<style>
    body {
  margin: 0;
  min-height: 100%;
        background-color: #354152;
        color: #7e8ba3;
        font: 300 #{1rem}/#{1.5} Helvetica Neue, sans-serif;
    }

    .grid {
        margin: 0 auto;
        max-width: 25rem;
        width: 100%;
    }

    .align {
        align-items: center;
        display: flex;
        flex-direction: row;
    }
    h2 {
  font-size: 2.75rem;
  font-weight: 100;
  margin: 0 0 2rem;
  text-transform: uppercase;
}

    .form-field {
        margin-bottom: 1rem;
    }

    .register {
        box-shadow: 0 0 250px #000;
        text-align: center;
        padding: 2rem 0;
    }

    .button {
        background-color: #4CAF50; /* Green */
        border: none;
        border-radius: 8px;
        color: white;
        padding: 15px 32px;
        text-align: center;
        text-decoration: none;
        display: inline-block;
        font-size: 14px;
        width: 70%;
        margin-top: 15px !important;
        margin: 4px 2px;
        cursor: pointer;
        -webkit-transition-duration: 0.4s; /* Safari */
        transition-duration: 0.4s;
    }

    .button2:hover {
        box-shadow: 0 12px 16px 0 rgba(0,0,0,0.24),0 17px 50px 0 rgba(0,0,0,0.19);
    }

    .username {
        width: 80%;
        color: rgb(38, 50, 56);
        font-weight: 700;
        font-size: 14px;
        letter-spacing: 1px;
        background: #e9ecef;
        padding: 10px 20px;
        border: none;
        border-radius: 1.5rem;
        outline: none;
        box-sizing: border-box;
        border: 2px solid rgba(0, 0, 0, 0.02);
        margin-bottom: 50px;
        text-align: center;
        margin-bottom: 27px;
        font-family: 'Ubuntu', sans-serif;
    }
        .username:focus{
            border: 2px solid rgba(0, 0, 0, 0.18) !important;
        }

    a{
    color:#7e8ba3;
    text-decoration: none;
    }
    a:hover{
        color:#666f80;
    }

</style>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
