@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Mvc.Rendering
@using TestStartDP.Data


<div class="modal fade show" id="myModal" style="display:block; background-color: rgba(10,10,10,.8);" aria-modal="true" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content" style="width: 150%; right: 25%;">
            <div class="modal-header">
                <h4 class="modal-title">@Title</h4>
                <button type="button" class="close" @onclick="@ModalCancel">&times;</button>
            </div>
            <div class="modal-body">
                <EditForm EditContext="this.editContext" OnSubmit="Save" id="testForm">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-sm-4">
                                <!-- text input -->
                                <div class="form-group required">
                                    <label class="control-label">
                                        Име:
                                    </label>
                                    <InputText class="form-control" placeholder="Име" @bind-Value="model.FirstName" />
                                </div>
                            </div>

                            <div class="col-sm-4">
                                <!-- text input -->
                                <div class="form-group required">
                                    <label class="control-label">
                                        Презиме:
                                    </label>
                                    <div>
                                        <InputText class="form-control" placeholder="Презиме" @bind-Value="model.SecondName" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <!-- text input -->
                                <div class="form-group required">
                                    <label class="control-label">
                                        Фамилия:
                                    </label>
                                    <div>

                                        <InputText class="form-control" placeholder="Фамилия" @bind-Value="model.FamilyName" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-4">
                                <!-- text input -->
                                <div class="form-group required">
                                    <label class="control-label">
                                        ЕГН:
                                    </label>
                                    <div>
                                        <InputText class="form-control" placeholder="ЕГН" @onfocusout="() => IsEGNValid()" @bind-Value="model.Indent" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <!-- text input -->
                                <div class="form-group">
                                    <label class="control-label">
                                        Дата на раждане:
                                    </label>
                                    <InputDate TValue="DateTime?" class="form-control" @bind-Value="this.model.BirthDate" Format="dd.MM.yyyy"></InputDate>
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <!-- text input -->
                                <div class="form-group required">
                                    <label class="control-label">
                                        Пол:
                                    </label>
                                    <div>
                                        <InputSelect @bind-Value="model.Sex" class="form-control">
                                            <option disabled="true" value="Пол">Пол</option>
                                            <option value="Мъж">Мъж</option>
                                            <option value="Жена">Жена</option>
                                            <option value="Друго">Друго</option>
                                        </InputSelect>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-10">
                                <InputSelect id="role-select" @bind-Value="newUser.UserRole">
                                    @foreach (var role in selectList)
                                    {
                                        <option value="@role.Value" selected=@role.Selected>@role.Text</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                    </div>


                </EditForm>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" @onclick="@ModalCancel">Отказ</button>
                <button type="submit" form="testForm" class="btn btn-primary">Запиши</button>

            </div>
        </div>
    </div>
</div>

