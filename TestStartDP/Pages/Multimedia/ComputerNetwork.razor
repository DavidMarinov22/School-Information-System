        a:hover {
            color: white;
        }
</style>

@code {

     private IEnumerable<FileModel> Model = new List<FileModel>();

    protected override void OnInitialized()
    {
        string[] filePaths = Directory.GetFiles(Path.Combine(this._environment.WebRootPath, "Resource/Мултимедия КМ/"));

        List<FileModel> list = new List<FileModel>();
        foreach (var filePath in filePaths)
        {
            list.Add(new FileModel() { FileName = Path.GetFileName(filePath) });
        }
        Model = list.OrderBy(f => f.FileName).ToList();
        foreach(var item in Model)
        {
            if(item.FileName.Contains(".docx"))
            {
                item.FileNameFiltered = item.FileName.Replace(".docx", "");
            }
            else if(item.FileName.Contains(".doc"))
            {
                item.FileNameFiltered = item.FileName.Replace(".doc", "");
            }
            else if(item.FileName.Contains(".pptx"))
            {
                item.FileNameFiltered = item.FileName.Replace(".pptx", "");
            }
            else if(item.FileName.Contains(".ppt"))
            {
                item.FileNameFiltered = item.FileName.Replace(".ppt", "");
            }
            else if(item.FileName.Contains(".pptm"))
            {
                item.FileNameFiltered = item.FileName.Replace(".pptm", "");
            }
            else if(item.FileName.Contains(".odt"))
            {
                item.FileNameFiltered = item.FileName.Replace(".odt", "");
            }
            else if(item.FileName.Contains(".odp"))
            {
                item.FileNameFiltered = item.FileName.Replace(".odp", "");
            }
        }
    }

    public async void DownloadFile(string fileName)
    {
        string path = Path.Combine(this._environment.WebRootPath, "Resource/Мултимедия КМ/") + fileName;
        MemoryStream ms = new MemoryStream();
        using(ms = new MemoryStream())
        {
            using(FileStream file = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.ReadWrite))
            {
                var bytes = new byte[file.Length];
                file.Read(bytes, 0, (int)file.Length);
                ms.Write(bytes, 0, (int)file.Length);
            
            }
                await FileUtils.SaveAs(this.JSRuntime, fileName, ms.ToArray());
        }

    }
}
