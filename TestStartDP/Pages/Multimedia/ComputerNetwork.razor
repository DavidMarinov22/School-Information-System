@page "/ComputerNetwork"

@inject IJSRuntime JSRuntime
@inject IWebHostEnvironment _environment

@using System.Data
@using Microsoft.AspNetCore.Mvc
@using TestStartDP.Data

<h3></h3>
@*<InputFile multiple ></InputFile>

<button class="btn btn-success">Upload to SQL</button>
<br />*@
<div class="table-container">
    <h2 class="table-heading">Компютърни мрежи</h2>

    <table>
        <thead>
            <tr>
                <th>Файл</th>
            </tr>
        </thead>

        <tbody>
            @foreach (FileModel file in Model)
            {
                <tr>
                    <td><a @onclick="@(() => {DownloadFile(file.FileName);})" href="/ComputerNetwork">@file.FileNameFiltered</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    body {
        height: 100%;
    }

    body {
        margin: 0;
        background: linear-gradient(90deg, #49a09d, #5f2c82);
        font-family: sans-serif;
        font-weight: 100;
    }

    .table-container {
        padding: 32px;
        font-family: "Roboto", sans-serif;
    }

        .table-container h2.table-heading {
