@page "/UsersList"

@using TestStartDP.Data
@inject IPersonService PersonService

<h3>Потребители</h3>

@*<select name="cars" id="cars">
    @foreach (var user in users)
            {
               <option value="@user.IdPerson">@user.FirstName</option>
            }
  
  <option value="saab">Saab</option>
  <option value="mercedes">Mercedes</option>
  <option value="audi">Audi</option>
</select>*@
<button type="button" class="btn btn-primary" @onclick="OpenModal">Добави</button>
<table class='table'>
        <thead>
            <tr>
                <th>Име</th>
                <th>Презиме</th>
                <th>Фамилия</th>
                <th>Роля</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in users)
            {
                <tr>
                    <td>@user.FirstName</td>
                    <td>@user.SecondName</td>
                    <td>@user.FamilyName</td>
                    <td>@user.RoleName</td>
                </tr>
            }
        </tbody>
    </table>
    @if(IsOpenUserModal)
    {
        <UsersModal Title="Добавяне на нов потребител" OnClose="CloseModal" OnSubmit="SaveAfterSubmit"></UsersModal>
    }
@code {
    private bool IsOpenUserModal = false;
    private IEnumerable<PersonVM> users = new List<PersonVM>();
    protected override void OnInitialized()
    {
        this.users = this.PersonService.GetAllPersons();
    }

    private void OpenModal()
    {
        this.IsOpenUserModal = true;
        this.StateHasChanged();
    }

    private void CloseModal()
    {
        this.IsOpenUserModal = false;
        this.StateHasChanged();
    }

    private async Task SaveAfterSubmit(PersonVM model)
    {
        var msg = await this.PersonService.CreatePersonAsync(model);
        //if(msg.Contains("ERROR/"))
            //{
            //    msg = msg.Replace("ERROR/", "");
            //}
            //else
            //{  
            //}

        this.IsOpenUserModal = false;
        
        this.users = this.PersonService.GetAllPersons();
        this.StateHasChanged();
    }
}
