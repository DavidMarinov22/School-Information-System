<AuthorizeView Policy="AdminPolicy">
    <Authorized>
    <div class="table-container">
    <h2 class="table-heading">Потребители</h2>
        <button type="button" class="btn btn-primary" @onclick="OpenModal">Добави</button>
    
        <table class='table'>
        <thead>
            <tr>
                <th>Име</th>
                <th>Презиме</th>
                <th>ЕГН</th>
                <th>Имейл</th>
                <th>Роля</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in users)
            {
                <tr>
                    <td>@user.FirstName</td>
                    <td>@user.FamilyName</td>
                    <td>@user.Indent</td>
                    <td>@user.Email</td>
                    <td>@user.RoleName</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    </Authorized>
</AuthorizeView>

