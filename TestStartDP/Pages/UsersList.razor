<style>
    body {
        height: 100%;
    }

    body {
        margin: 0;
        background: linear-gradient(90deg, #0D324D, #7F5A83);
        font-family: sans-serif;
        font-weight: 100;
    }
    table {
        border: 0;
    }
    .table-container {
        padding: 32px;
        font-family: "Roboto", sans-serif;
    }

        .table-container h2.table-heading {
            text-align: center;
            text-transform: uppercase;
            font-size: 24px;
            margin-bottom: 32px;
            padding-bottom: 8px;
        }
        .table-container button {
            margin-bottom: 10px;
            margin-left: 25%;
            background-color: #55608f;
        }
        .table-container button:hover {
            
            background-color: gray;
        }

        .table-container table {
            width: 50%;
            margin-left: 25%;
            color: #222;
            padding: 24px;
            box-shadow: 0 4px 15px -8px rgba(0, 0, 0, 0.4);
            border-collapse: collapse;
        }

            .table-container table thead tr {
                background-color: #55608f;
                color: white;
                text-align: center;
            }


            .table-container table td,
            .table-container table th {
                padding: 15px;
                background-color: rgba(255,255,255,0.2);
                color: white;
                text-align: center;
                border: none;
            }


</style>
    @if(IsOpenUserModal)
    {
        <UsersModal Title="Добавяне на нов потребител" OnClose="CloseModal" OnSubmit="SaveAfterSubmit"></UsersModal>
    }
@code {
    private bool IsOpenUserModal = false;
    private IEnumerable<PersonVM> users = new List<PersonVM>();
    protected override void OnInitialized()
    {
        this.users = this.PersonService.GetAllPersons();
    }

    private void OpenModal()
    {
        this.IsOpenUserModal = true;
        this.StateHasChanged();
    }

    private void CloseModal()
    {
        this.IsOpenUserModal = false;
        this.StateHasChanged();
    }

    private async Task SaveAfterSubmit(PersonVM model)
    {
        var msg = await this.PersonService.CreatePersonAsync(model);
        //if(msg.Contains("ERROR/"))
            //{
            //    msg = msg.Replace("ERROR/", "");
            //}
            //else
            //{  
            //}

        this.IsOpenUserModal = false;
        
        this.users = this.PersonService.GetAllPersons();
        await this.JsRuntime.InvokeVoidAsync("alert", "Успешно създаден профил!");
        this.StateHasChanged();
    }
}
