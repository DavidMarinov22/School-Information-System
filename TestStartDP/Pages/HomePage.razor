@page "/homepage"
@using Microsoft.AspNetCore.Identity
@using TestStartDP.Data
@attribute [Authorize(Roles="Admin, User, Teacher")]

@inject IPersonService PersonService
@inject IJSRuntime JsRuntime
@inject UserManager<IdentityUser> _userManager
@inject SignInManager<IdentityUser> _signInManager

<h1>Welcome to the school information system</h1>
 
@if (isNew)
{
    <UsersModal Title="New user to the system" OnClose="CloseModal" OnSubmit="SaveAfterSubmit" User="user"></UsersModal>
}
<style>
    body{
         background-image: linear-gradient(rgba(0,8,51,0.9), rgba(0,8,51,0.9)), url(../images/background.jpg);
        background-size: cover;
    }

    h1{
        color: white;
    }

</style>
@code {
    [CascadingParameter] protected Task<AuthenticationState> AuthStat { get; set; }
    private bool isNew = false;
    private IdentityUser user;
    protected override async Task OnInitializedAsync()
    {
        user = await _userManager.FindByNameAsync((await AuthStat).User.Identity.Name);

        isNew = user.PhoneNumber == null;
    }

    private void CloseModal()
    {
        this.isNew = false;
        this.StateHasChanged();
    }


    private async Task SaveAfterSubmit(PersonVM model)
    {
        var msg = await this.PersonService.CreatePersonAsync(model);
        //if(msg.Contains("ERROR/"))
        //{
        //    msg = msg.Replace("ERROR/", "");
        //}
        //else
        //{  
        //}
        this.user.PhoneNumber = "";
        var result = await _userManager.UpdateAsync(this.user);
        if (result.Succeeded)
        {
            this.isNew = false;
            await this.JsRuntime.InvokeVoidAsync("alert", "Успешно добавен потребител!");
            this.StateHasChanged();   
        }
    }
}
